{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nahadai-telegram",
  "main": "src/index.js",
  "compatibility_date": "2026-07-17",
  "triggers": {
    "crons": ["* * * * *"]
  }

  // D1 binding and variables should match the existing Worker configuration.
  // Example:
  // "d1_databases": [
  //   {
  //     "binding": "DB",
  //     "database_name": "YOUR_DB_NAME",
  //     "database_id": "YOUR_DB_ID"
  //   }
  // ]
}
