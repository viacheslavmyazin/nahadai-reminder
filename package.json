const DEFAULT_TIME_ZONE = "Europe/Kyiv";

function appUrl(env) {
  return env.APP_URL || "https://viacheslavmyazin.github.io/nahadai-reminder/";
}

function escapeHtml(value = "") {
  return String(value).replace(/[&<>"']/g, (char) => ({
    "&": "&amp;",
    "<": "&lt;",
    ">": "&gt;",
    '"': "&quot;",
    "'": "&#39;",
  })[char]);
}

function normalizeTimeZone(value) {
  const candidate = value || DEFAULT_TIME_ZONE;
  try {
    new Intl.DateTimeFormat("en-US", { timeZone: candidate }).format();
    return candidate;
  } catch {
    return DEFAULT_TIME_ZONE;
  }
}

function zonedParts(timestamp, timeZone) {
  const parts = new Intl.DateTimeFormat("en-CA", {
    timeZone,
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit",
    hourCycle: "h23",
  }).formatToParts(new Date(timestamp));

  const values = Object.fromEntries(
    parts.filter((part) => part.type !== "literal").map((part) => [part.type, Number(part.value)]),
  );

  return {
    year: values.year,
    month: values.month,
    day: values.day,
    hour: values.hour,
    minute: values.minute,
    second: values.second,
  };
}

function localPartsToTimestamp(parts, timeZone) {
  const wanted = Date.UTC(
    parts.year,
    parts.month - 1,
    parts.day,
    parts.hour,
    parts.minute,
    parts.second || 0,
  );
  let guess = wanted;

  for (let attempt = 0; attempt < 4; attempt += 1) {
    const actual = zonedParts(guess, timeZone);
    const represented = Date.UTC(
      actual.year,
      actual.month - 1,
      actual.day,
      actual.hour,
      actual.minute,
      actual.second || 0,
    );
    guess += wanted - represented;
  }

  return guess;
}

function addLocalDays(parts, days) {
  const date = new Date(Date.UTC(
    parts.year,
    parts.month - 1,
    parts.day + days,
    parts.hour,
    parts.minute,
    parts.second || 0,
  ));

  return {
    year: date.getUTCFullYear(),
    month: date.getUTCMonth() + 1,
    day: date.getUTCDate(),
    hour: parts.hour,
    minute: parts.minute,
    second: parts.second || 0,
  };
}

function todayBounds(now = Date.now(), timeZone = DEFAULT_TIME_ZONE) {
  const local = zonedParts(now, timeZone);
  const startParts = {
    year: local.year,
    month: local.month,
    day: local.day,
    hour: 0,
    minute: 0,
    second: 0,
  };

  return {
    start: localPartsToTimestamp(startParts, timeZone),
    end: localPartsToTimestamp(addLocalDays(startParts, 1), timeZone),
  };
}

async function telegramApi(env, method, payload) {
  if (!env.TELEGRAM_BOT_TOKEN) {
    throw new Error("TELEGRAM_BOT_TOKEN is not configured");
  }

  const response = await fetch(
    `https://api.telegram.org/bot${env.TELEGRAM_BOT_TOKEN}/${method}`,
    {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify(payload),
    },
  );

  const result = await response.json().catch(() => null);
  if (!response.ok || !result?.ok) {
    throw new Error(`Telegram ${method} failed: ${response.status} ${JSON.stringify(result)}`);
  }

  return result.result;
}

function mainKeyboard(env) {
  return {
    keyboard: [
      [
        { text: "📅 Сьогодні" },
        { text: "⚠️ Прострочені" },
      ],
      [
        { text: "📋 Активні" },
        { text: "✅ Виконані" },
      ],
      [
        { text: "➕ Створити задачу" },
      ],
      [
        { text: "🌿 Відкрити планувальник", web_app: { url: appUrl(env) } },
      ],
    ],
    resize_keyboard: true,
    is_persistent: true,
    input_field_placeholder: "Оберіть дію",
  };
}

async function findUser(env, telegramId) {
  return env.DB.prepare(
    "SELECT id, telegram_id, display_name, username FROM users WHERE telegram_id = ?",
  ).bind(String(telegramId)).first();
}

function priorityIcon(priority) {
  return ({ high: "🔴", medium: "🟡", low: "🟢" })[priority] || "🟡";
}

function itemTypeIcon(itemType) {
  return itemType === "task" ? "📋" : "🔔";
}

async function sendMainMenu(env, chatId, displayName = "") {
  const greeting = displayName
    ? `Вітаю, <b>${escapeHtml(displayName)}</b>!`
    : "Вітаю!";

  await telegramApi(env, "sendMessage", {
    chat_id: chatId,
    text: [
      "🌿 <b>Нагадай</b>",
      "",
      greeting,
      "Що потрібно зробити?",
    ].join("\n"),
    parse_mode: "HTML",
    reply_markup: mainKeyboard(env),
  });
}

function listQuery(mode, userId, now) {
  const { start, end } = todayBounds(now, DEFAULT_TIME_ZONE);

  if (mode === "today") {
    return {
      title: "📅 <b>Справи на сьогодні</b>",
      sql: `
        SELECT id, title, note, due_at, priority, done, item_type, status, timezone
        FROM reminders
        WHERE user_id = ? AND due_at >= ? AND due_at < ?
        ORDER BY done ASC, due_at ASC
        LIMIT 30
      `,
      params: [userId, start, end],
    };
  }

  if (mode === "overdue") {
    return {
      title: "⚠️ <b>Прострочені справи</b>",
      sql: `
        SELECT id, title, note, due_at, priority, done, item_type, status, timezone
        FROM reminders
        WHERE user_id = ? AND done = 0 AND due_at < ?
        ORDER BY due_at ASC
        LIMIT 30
      `,
      params: [userId, now],
    };
  }

  if (mode === "done") {
    return {
      title: "✅ <b>Останні виконані справи</b>",
      sql: `
        SELECT id, title, note, due_at, priority, done, item_type, status, timezone
        FROM reminders
        WHERE user_id = ? AND done = 1
        ORDER BY updated_at DESC
        LIMIT 20
      `,
      params: [userId],
    };
  }

  return {
    title: "📋 <b>Усі активні справи</b>",
    sql: `
      SELECT id, title, note, due_at, priority, done, item_type, status, timezone
      FROM reminders
      WHERE user_id = ? AND done = 0
      ORDER BY due_at ASC
      LIMIT 30
    `,
    params: [userId],
  };
}

async function sendList(env, chatId, mode) {
  const user = await findUser(env, chatId);
  if (!user) {
    await telegramApi(env, "sendMessage", {
      chat_id: chatId,
      text: "Спочатку відкрийте планувальник через Telegram і виконайте вхід.",
      reply_markup: {
        inline_keyboard: [[
          { text: "🌿 Відкрити «Нагадай»", web_app: { url: appUrl(env) } },
        ]],
      },
    });
    return;
  }

  const now = Date.now();
  const query = listQuery(mode, user.id, now);
  const statement = env.DB.prepare(query.sql);
  const { results = [] } = await statement.bind(...query.params).all();

  if (!results.length) {
    await telegramApi(env, "sendMessage", {
      chat_id: chatId,
      text: `${query.title}\n\nСписок порожній 🎉`,
      parse_mode: "HTML",
      reply_markup: mainKeyboard(env),
    });
    return;
  }

  const lines = [query.title, "", `Кількість: <b>${results.length}</b>`, ""];

  for (const [index, item] of results.entries()) {
    const timeZone = normalizeTimeZone(item.timezone);
    const due = new Date(Number(item.due_at));
    const date = new Intl.DateTimeFormat("uk-UA", {
      day: "2-digit",
      month: "2-digit",
      timeZone,
    }).format(due);
    const time = new Intl.DateTimeFormat("uk-UA", {
      hour: "2-digit",
      minute: "2-digit",
      timeZone,
    }).format(due);

    const state = item.done ? "✅" : priorityIcon(item.priority);
    lines.push(`${index + 1}. ${state} ${itemTypeIcon(item.item_type)} <b>${escapeHtml(item.title)}</b>`);
    lines.push(`   🕒 ${date}, ${time}`);
    if (item.note) lines.push(`   📝 ${escapeHtml(item.note).slice(0, 140)}`);
    lines.push("");
  }

  const inlineKeyboard = [];
  for (const item of results.filter((row) => !row.done).slice(0, 8)) {
    inlineKeyboard.push([
      { text: `✅ ${String(item.title).slice(0, 22)}`, callback_data: `done:${item.id}` },
      { text: "📅 Завтра", callback_data: `tomorrow:${item.id}` },
    ]);
  }
  inlineKeyboard.push([{ text: "🔄 Оновити", callback_data: `list:${mode}` }]);
  inlineKeyboard.push([{ text: "🌿 Відкрити планувальник", web_app: { url: appUrl(env) } }]);

  await telegramApi(env, "sendMessage", {
    chat_id: chatId,
    text: lines.join("\n").slice(0, 3900),
    parse_mode: "HTML",
    reply_markup: { inline_keyboard: inlineKeyboard },
  });
}

async function sendCreateHint(env, chatId) {
  await telegramApi(env, "sendMessage", {
    chat_id: chatId,
    text: [
      "➕ <b>Створення задачі</b>",
      "",
      "У цій версії створення відкривається в Mini App.",
      "Наступним кроком додамо створення прямо повідомленням у Telegram.",
    ].join("\n"),
    parse_mode: "HTML",
    reply_markup: {
      inline_keyboard: [[
        { text: "➕ Створити у планувальнику", web_app: { url: appUrl(env) } },
      ]],
    },
  });
}

async function handleMessage(env, message) {
  const chatId = String(message.chat?.id || "");
  const text = String(message.text || "").trim();
  if (!chatId) return;

  if (/^\/start(?:@\w+)?(?:\s|$)/i.test(text)) {
    const user = await findUser(env, chatId);
    if (!user) {
      await telegramApi(env, "sendMessage", {
        chat_id: chatId,
        text: [
          "👋 Вітаємо у «Нагадай»!",
          "",
          "Відкрийте планувальник кнопкою нижче та виконайте вхід через Telegram.",
        ].join("\n"),
        reply_markup: {
          inline_keyboard: [[
            { text: "🌿 Відкрити «Нагадай»", web_app: { url: appUrl(env) } },
          ]],
        },
      });
      return;
    }

    await sendMainMenu(env, chatId, user.display_name || "");
    return;
  }

  if (/^\/(menu|help)(?:@\w+)?$/i.test(text)) {
    const user = await findUser(env, chatId);
    await sendMainMenu(env, chatId, user?.display_name || "");
    return;
  }

  if (/^\/today(?:@\w+)?$/i.test(text) || text === "📅 Сьогодні") {
    await sendList(env, chatId, "today");
    return;
  }

  if (/^\/overdue(?:@\w+)?$/i.test(text) || text === "⚠️ Прострочені") {
    await sendList(env, chatId, "overdue");
    return;
  }

  if (/^\/active(?:@\w+)?$/i.test(text) || text === "📋 Активні") {
    await sendList(env, chatId, "active");
    return;
  }

  if (/^\/done(?:@\w+)?$/i.test(text) || text === "✅ Виконані") {
    await sendList(env, chatId, "done");
    return;
  }

  if (text === "➕ Створити задачу" || /^\/new(?:@\w+)?$/i.test(text)) {
    await sendCreateHint(env, chatId);
    return;
  }

  await telegramApi(env, "sendMessage", {
    chat_id: chatId,
    text: [
      "Команда поки не розпізнана.",
      "",
      "/today — справи на сьогодні",
      "/overdue — прострочені",
      "/active — активні",
      "/done — виконані",
      "/new — створити задачу",
      "/menu — головне меню",
    ].join("\n"),
    reply_markup: mainKeyboard(env),
  });
}

async function answerCallback(env, callbackQueryId, text, showAlert = false) {
  await telegramApi(env, "answerCallbackQuery", {
    callback_query_id: callbackQueryId,
    text,
    show_alert: showAlert,
  });
}

async function editMessage(env, chatId, messageId, text) {
  await telegramApi(env, "editMessageText", {
    chat_id: chatId,
    message_id: messageId,
    text,
    parse_mode: "HTML",
  });
}

async function handleCallback(env, callbackQuery) {
  const callbackId = String(callbackQuery.id || "");
  const data = String(callbackQuery.data || "");
  const chatId = String(callbackQuery.message?.chat?.id || "");
  const messageId = callbackQuery.message?.message_id;
  const [action, value] = data.split(":", 2);

  if (!callbackId || !chatId || !messageId || !action || !value) return;

  if (action === "list") {
    await answerCallback(env, callbackId, "Оновлюємо список");
    await sendList(env, chatId, value);
    return;
  }

  const reminder = await env.DB.prepare(
    `SELECT r.id, r.user_id, r.title, r.due_at, r.timezone, u.telegram_id
     FROM reminders r
     JOIN users u ON u.id = r.user_id
     WHERE r.id = ? AND u.telegram_id = ?`,
  ).bind(value, chatId).first();

  if (!reminder) {
    await answerCallback(env, callbackId, "Задачу не знайдено", true);
    return;
  }

  const now = Date.now();

  if (action === "done") {
    await env.DB.prepare(
      "UPDATE reminders SET done = 1, sent = 1, status = 'done', updated_at = ? WHERE id = ? AND user_id = ?",
    ).bind(now, reminder.id, reminder.user_id).run();

    await answerCallback(env, callbackId, "Позначено виконаним");
    await editMessage(env, chatId, messageId, `✅ <b>Виконано</b>\n\n${escapeHtml(reminder.title)}`);
    return;
  }

  if (action === "tomorrow") {
    const timeZone = normalizeTimeZone(reminder.timezone);
    const current = zonedParts(Number(reminder.due_at), timeZone);
    let nextDueAt = localPartsToTimestamp(addLocalDays(current, 1), timeZone);

    if (nextDueAt <= now) {
      nextDueAt = localPartsToTimestamp(addLocalDays(zonedParts(now, timeZone), 1), timeZone);
    }

    await env.DB.prepare(
      "UPDATE reminders SET due_at = ?, done = 0, sent = 0, status = 'planned', updated_at = ? WHERE id = ? AND user_id = ?",
    ).bind(nextDueAt, now, reminder.id, reminder.user_id).run();

    const date = new Intl.DateTimeFormat("uk-UA", { dateStyle: "long", timeZone }).format(new Date(nextDueAt));
    const time = new Intl.DateTimeFormat("uk-UA", { hour: "2-digit", minute: "2-digit", timeZone }).format(new Date(nextDueAt));

    await answerCallback(env, callbackId, "Перенесено на завтра");
    await editMessage(
      env,
      chatId,
      messageId,
      `📅 <b>Перенесено</b>\n\n${escapeHtml(reminder.title)}\n\nНова дата: <b>${date}, ${time}</b>`,
    );
    return;
  }

  await answerCallback(env, callbackId, "Невідома дія", true);
}

export async function handleTelegramWebhookV2(request, env) {
  if (env.TELEGRAM_WEBHOOK_SECRET) {
    const provided = request.headers.get("x-telegram-bot-api-secret-token") || "";
    if (provided !== env.TELEGRAM_WEBHOOK_SECRET) {
      console.warn("Telegram webhook rejected: invalid secret token");
      return new Response("Forbidden", { status: 403 });
    }
  }

  const update = await request.json().catch(() => null);
  if (!update) return new Response("Bad Request", { status: 400 });

  console.log("Telegram update", {
    updateId: update.update_id,
    hasMessage: Boolean(update.message),
    hasCallback: Boolean(update.callback_query),
  });

  try {
    if (update.callback_query) {
      await handleCallback(env, update.callback_query);
    } else if (update.message) {
      await handleMessage(env, update.message);
    }
  } catch (error) {
    console.error("Telegram V2 processing failed", error?.stack || error);
  }

  return new Response("OK", { status: 200 });
}
